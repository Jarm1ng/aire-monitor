#!/usr/bin/expect -f
#
# Interactive AIRE login helper for the macOS app.
#
# Reads configuration from environment variables:
#   AIRE_CONNECTION_MODE ("alias" or "explicit")
#   AIRE_SSH_ALIAS
#   AIRE_USERNAME
#   AIRE_HOSTNAME
#   AIRE_USE_JUMP_HOST ("1" or "0")
#   AIRE_JUMP_HOSTNAME
#   AIRE_CONTROL_PATH
#   AIRE_JUMP_CONTROL_PATH
#   AIRE_FORCE_RELOGIN ("1" or "0")
#   AIRE_LOGIN_DEBUG_LOG
#   AIRE_DUO_OPTION
#   AIRE_TIMEOUT
#   AIRE_PROJECT_ROOT (defaults to the parent directory of this script)
#
# Reads the password from stdin (preferred). AIRE_PASSWORD is accepted as a
# legacy fallback; both password variables are scrubbed from the environment
# immediately after reading so spawned ssh processes never inherit them.
#
# Progress is reported on stdout as machine-readable lines:
#   AIRE-STATUS: <human-readable milestone>
#
# Exit codes:
#   13  the remote host rejected the password (wrong password)
#   124 timed out waiting for a prompt
#
# The helper only starts OpenSSH ControlMaster sessions and verifies them with
# read-only commands.

fconfigure stdout -buffering line

proc env_or_default {name default} {
    if {[info exists ::env($name)] && $::env($name) ne ""} {
        return $::env($name)
    }
    return $default
}

set script_dir [file dirname [file normalize [info script]]]
set project_root [env_or_default "AIRE_PROJECT_ROOT" [file dirname $script_dir]]

# Resolve a helper/log path against the project root so the script works when
# invoked from any working directory. Control-socket paths supplied via the
# environment are intentionally left as-is: relative socket paths keep the
# sun_path length short and are resolved by ssh against the caller's cwd.
proc resolve_path {path} {
    global project_root
    if {$path eq ""} {
        return ""
    }
    if {[string index $path 0] eq "/"} {
        return $path
    }
    return [file join $project_root $path]
}

set username [env_or_default "AIRE_USERNAME" ""]
set connection_mode [env_or_default "AIRE_CONNECTION_MODE" "alias"]
set ssh_alias [env_or_default "AIRE_SSH_ALIAS" "aire"]
set aire_hostname [env_or_default "AIRE_HOSTNAME" "aire.leeds.ac.uk"]
set use_jump_host [env_or_default "AIRE_USE_JUMP_HOST" "1"]
set jump_hostname [env_or_default "AIRE_JUMP_HOSTNAME" "rash.leeds.ac.uk"]
set control_path [env_or_default "AIRE_CONTROL_PATH" ""]
set jump_control_path [env_or_default "AIRE_JUMP_CONTROL_PATH" ""]
set force_relogin [env_or_default "AIRE_FORCE_RELOGIN" "0"]
set skip_target [env_or_default "AIRE_SKIP_TARGET" "0"]
set debug_log [resolve_path [env_or_default "AIRE_LOGIN_DEBUG_LOG" ""]]
set duo_option [env_or_default "AIRE_DUO_OPTION" "1"]
set timeout [env_or_default "AIRE_TIMEOUT" "120"]

if {$connection_mode ne "alias" && $username eq ""} {
    puts stderr "AIRE_USERNAME is required"
    exit 2
}

if {$connection_mode eq "alias" && $ssh_alias eq ""} {
    puts stderr "AIRE_SSH_ALIAS is required when AIRE_CONNECTION_MODE=alias"
    exit 2
}

if {$connection_mode ne "alias" && $use_jump_host eq "1" && $jump_control_path eq ""} {
    # Keep the fallback socket path short: unix sockets are capped at 104
    # bytes on macOS and ssh appends a random suffix during setup.
    set jump_control_path "$::env(HOME)/.ssh/ctl/jump-cli-$username.sock"
}

if {[info exists ::env(AIRE_PASSWORD)] && $::env(AIRE_PASSWORD) ne ""} {
    set password $::env(AIRE_PASSWORD)
} else {
    if {[gets stdin password] < 0} {
        puts stderr "Password was not provided on stdin"
        exit 2
    }
}

# Scrub inherited secrets so no spawned ssh child carries them in its
# environment. The password only lives in this process's memory from here on.
catch {unset ::env(AIRE_PASSWORD)}
catch {unset ::env(AIRE_ASKPASS_PASSWORD)}

if {$password eq ""} {
    puts stderr "Password was empty"
    exit 2
}

proc ensure_directory {dir} {
    if {$dir eq ""} {
        return
    }
    file mkdir $dir
    catch {file attributes $dir -permissions 0700}
}

proc ensure_parent_directory {path} {
    if {$path eq ""} {
        return
    }
    set parent [file dirname $path]
    if {$parent ne "." && $parent ne ""} {
        ensure_directory $parent
    }
}

ensure_parent_directory $control_path
ensure_parent_directory $jump_control_path

proc log_event {message} {
    global debug_log
    if {$debug_log eq ""} {
        return
    }
    set timestamp [clock format [clock seconds] -format "%Y-%m-%d %H:%M:%S %Z"]
    if {[catch {
        set handle [open $debug_log "a"]
        puts $handle "$timestamp $message"
        close $handle
        file attributes $debug_log -permissions 0600
    }]} {
        return
    }
}

proc status_line {message} {
    puts "AIRE-STATUS: $message"
}

proc starting_message {label} {
    if {$label eq "jump host"} {
        return "starting jump-host authentication"
    }
    return "starting $label authentication"
}

proc connected_message {label} {
    if {$label eq "jump host"} {
        return "jump host connected"
    }
    return "connected to $label"
}

proc interactive_base_args {} {
    return [list \
        ssh \
        -o StrictHostKeyChecking=accept-new \
        -o PubkeyAuthentication=no \
        -o GSSAPIAuthentication=no \
        -o PreferredAuthentications=password,keyboard-interactive \
        -o KbdInteractiveAuthentication=yes \
        -o PasswordAuthentication=yes \
        -o NumberOfPasswordPrompts=1 \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=10 \
        -o TCPKeepAlive=yes \
        -o ExitOnForwardFailure=yes \
        -o ConnectTimeout=20 \
    ]
}

proc verify_base_args {} {
    return [list \
        ssh \
        -n \
        -o BatchMode=yes \
        -o PubkeyAuthentication=no \
        -o GSSAPIAuthentication=no \
        -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no \
        -o ConnectTimeout=20 \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=10 \
        -o TCPKeepAlive=yes \
        -o ExitOnForwardFailure=yes \
    ]
}

proc add_interactive_master_options {args control_path} {
    if {$control_path ne ""} {
        lappend args \
            -o ControlMaster=yes \
            -o ControlPersist=24h \
            -o ControlPath=$control_path
    }
    return $args
}

proc add_background_master_options {args control_path} {
    if {$control_path ne ""} {
        lappend args \
            -o ControlMaster=yes \
            -o ControlPersist=no \
            -o ControlPath=$control_path
    }
    return $args
}

proc askpass_base_args {} {
    return [list \
        ssh \
        -o StrictHostKeyChecking=accept-new \
        -o PubkeyAuthentication=no \
        -o GSSAPIAuthentication=no \
        -o PreferredAuthentications=password,keyboard-interactive \
        -o KbdInteractiveAuthentication=yes \
        -o PasswordAuthentication=yes \
        -o NumberOfPasswordPrompts=1 \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=10 \
        -o TCPKeepAlive=yes \
        -o ExitOnForwardFailure=yes \
        -o ConnectTimeout=20 \
    ]
}

proc add_verify_master_options {args control_path} {
    if {$control_path ne ""} {
        lappend args \
            -o ControlPath=$control_path \
            -o ControlMaster=auto
    }
    return $args
}

proc shell_quote {value} {
    if {$value eq ""} {
        return "''"
    }
    regsub -all -- {'} $value {'"'"'} escaped
    return "'$escaped'"
}

proc shell_join {values} {
    set quoted [list]
    foreach value $values {
        lappend quoted [shell_quote $value]
    }
    return [join $quoted " "]
}

proc jump_proxy_command {} {
    global username jump_hostname jump_control_path
    if {$jump_control_path eq ""} {
        return ""
    }
    set proxy_args [list \
        ssh \
        -o BatchMode=yes \
        -o PubkeyAuthentication=no \
        -o GSSAPIAuthentication=no \
        -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no \
        -o ConnectTimeout=20 \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=10 \
        -o TCPKeepAlive=yes \
        -o ControlMaster=auto \
        -o ControlPath=$jump_control_path \
        -o User=$username \
        -W %h:%p \
        $jump_hostname \
    ]
    return [shell_join $proxy_args]
}

proc cleanup_control_socket {control_path} {
    if {$control_path ne "" && [file exists $control_path]} {
        log_event "Removing stale control socket: $control_path"
        file delete -force $control_path
    }
}

proc regex_escape {value} {
    return [regsub -all {[][{}()*+?.^$\\|]} $value {\\&}]
}

# Kill a pid only after verifying its argv is an ssh master whose *first*
# ControlPath option is exactly the socket we manage. The first-occurrence
# check matters: an AIRE master embeds the jump ControlPath inside its
# ProxyCommand string, so a naive substring match on the jump path would kill
# the AIRE master too.
proc kill_verified_pid {pid control_path} {
    set pid [string trim $pid]
    if {![string is integer -strict $pid] || $pid <= 0} {
        return 0
    }
    if {[catch {exec ps -p $pid -o command=} cmdline]} {
        return 0
    }
    set cmdline [string trim $cmdline]
    if {![regexp {^ssh(\s|$)} $cmdline]} {
        return 0
    }
    if {![regexp {ControlPath=(\S+)} $cmdline -> first_control_path]} {
        return 0
    }
    if {$first_control_path ne $control_path} {
        return 0
    }
    log_event "Terminating SSH master pid $pid for $control_path"
    catch {exec kill $pid}
    return 1
}

proc cleanup_orphan_master {control_path {pid_file ""}} {
    if {$control_path eq ""} {
        return
    }
    if {$pid_file ne "" && [file exists $pid_file]} {
        if {![catch {open $pid_file r} handle]} {
            set recorded_pid [string trim [read $handle]]
            close $handle
            kill_verified_pid $recorded_pid $control_path
        }
        catch {file delete -force $pid_file}
    }
    set pattern "^ssh .*ControlPath=[regex_escape $control_path]"
    if {[catch {exec pgrep -f $pattern} pid_output]} {
        return
    }
    foreach pid [split $pid_output "\n"] {
        kill_verified_pid $pid $control_path
    }
}

proc close_master {close_args label control_path} {
    global timeout
    if {$control_path eq ""} {
        return
    }
    log_event "Forcing fresh $label master"
    set stop_args [linsert $close_args 1 -O exit]
    set saved_timeout $timeout
    set timeout 6
    log_user 0
    if {[catch {spawn {*}$stop_args} spawn_error]} {
        log_event "Could not send $label master exit: $spawn_error"
        set timeout $saved_timeout
        log_user 1
        cleanup_control_socket $control_path
        return
    }
    expect {
        eof {
            set wait_result [wait]
            set exit_code [lindex $wait_result 3]
            log_event "$label master exit command returned $exit_code"
        }
        timeout {
            log_event "$label master exit command timed out"
            catch {close}
            catch {wait}
        }
    }
    set timeout $saved_timeout
    log_user 1
    cleanup_control_socket $control_path
    cleanup_orphan_master $control_path
}

proc run_interactive_ssh {ssh_args success_re label} {
    global password duo_option timeout expect_out
    set saw_success 0
    set password_prompts 0
    set duo_prompts 0
    set hostkey_prompts 0
    set effective_success_re $success_re
    if {$effective_success_re eq ""} {
        set effective_success_re "__AIRE_EXPECT_NO_SUCCESS_SENTINEL__"
    }

    log_event "Starting $label authentication"
    status_line [starting_message $label]
    log_user 0
    spawn {*}$ssh_args

    expect {
        -nocase -re {are you sure you want to continue connecting[^\r\n]*} {
            incr hostkey_prompts
            if {$hostkey_prompts > 2} {
                puts stderr "Unexpected repeated host-key prompts during $label authentication"
                log_event "$label host-key prompt loop detected"
                log_user 1
                catch {close}
                catch {wait}
                return 1
            }
            log_event "$label prompt: accepting new host key"
            send -- "yes\r"
            exp_continue
        }
        -nocase -re {password[^\r\n]*:\s*$} {
            incr password_prompts
            if {$password_prompts >= 2} {
                # An immediate re-prompt with no intervening Duo exchange
                # means the password was rejected. NumberOfPasswordPrompts=1
                # does not constrain the nested ssh spawned by a ProxyJump
                # alias, whose target leg legitimately asks for a password
                # after the jump leg's Duo prompt — the Duo branches below
                # reset this counter for that reason. Exit 13 is the app's
                # "password rejected" contract.
                puts stderr "$label rejected the password"
                log_event "$label password rejected (second password prompt)"
                log_user 1
                catch {close}
                catch {wait}
                return 13
            }
            log_event "$label prompt: sending password"
            send -- "$password\r"
            status_line "password sent, waiting for Duo approval on your phone ($label)"
            exp_continue
        }
        -nocase -re {passcode\s+or\s+option[^\r\n]*:\s*$} {
            incr duo_prompts
            if {$duo_prompts > 3} {
                puts stderr "$label Duo prompt repeated too many times; aborting"
                log_event "$label Duo prompt loop detected"
                log_user 1
                catch {close}
                catch {wait}
                return 1
            }
            log_event "$label prompt: sending Duo option"
            # Reaching a Duo prompt means the preceding password was accepted.
            # Reset the rejection counter so the next leg of a ProxyJump alias
            # route may ask for its own password; only an immediate re-prompt
            # (no intervening Duo exchange) counts as a rejection.
            set password_prompts 0
            send -- "$duo_option\r"
            status_line "waiting for Duo approval on your phone ($label)"
            exp_continue
        }
        -nocase -re {select one of the following options[^\r\n]*} {
            # Duo menu header; the actionable "Passcode or option (1-N):"
            # prompt follows. Consume it without answering.
            exp_continue
        }
        -nocase -re {option\s*\([^\)]*\)\s*:\s*$} {
            incr duo_prompts
            if {$duo_prompts > 3} {
                puts stderr "$label Duo prompt repeated too many times; aborting"
                log_event "$label Duo prompt loop detected"
                log_user 1
                catch {close}
                catch {wait}
                return 1
            }
            log_event "$label prompt: sending Duo option"
            set password_prompts 0
            send -- "$duo_option\r"
            status_line "waiting for Duo approval on your phone ($label)"
            exp_continue
        }
        -nocase -re {verification code[^\r\n]*:\s*$} {
            incr duo_prompts
            if {$duo_prompts > 3} {
                puts stderr "$label Duo prompt repeated too many times; aborting"
                log_event "$label Duo prompt loop detected"
                log_user 1
                catch {close}
                catch {wait}
                return 1
            }
            log_event "$label prompt: sending Duo option"
            set password_prompts 0
            send -- "$duo_option\r"
            status_line "waiting for Duo approval on your phone ($label)"
            exp_continue
        }
        -nocase -re {response[^\r\n]*:\s*$} {
            incr duo_prompts
            if {$duo_prompts > 3} {
                puts stderr "$label Duo prompt repeated too many times; aborting"
                log_event "$label Duo prompt loop detected"
                log_user 1
                catch {close}
                catch {wait}
                return 1
            }
            log_event "$label prompt: sending Duo option"
            set password_prompts 0
            send -- "$duo_option\r"
            status_line "waiting for Duo approval on your phone ($label)"
            exp_continue
        }
        -re $effective_success_re {
            set saw_success 1
            log_user 1
            puts $expect_out(0,string)
            log_user 0
            exp_continue
        }
        eof {
            set wait_result [wait]
            set exit_code [lindex $wait_result 3]
            log_event "$label authentication exited with $exit_code, success=$saw_success"
            log_user 1
            if {$success_re ne "" && $saw_success == 0 && $exit_code == 0} {
                return 1
            }
            return $exit_code
        }
        timeout {
            puts stderr "Timed out while waiting for $label SSH, password, or Duo prompt"
            log_event "$label authentication timed out"
            log_user 1
            return 124
        }
    }
}

# Run a verification command under a hard timeout. Uses spawn/expect instead
# of plain `exec` so a wedged mux command cannot hang the helper until the
# remote LoginGraceTime expires.
proc verify_ssh {verify_args {quiet 0}} {
    global timeout
    set saved_timeout $timeout
    set timeout 25
    set output ""
    log_user 0
    if {[catch {spawn {*}$verify_args} spawn_error]} {
        set timeout $saved_timeout
        log_user 1
        log_event "Verification spawn failed: $spawn_error"
        return 1
    }
    set exit_code 1
    expect {
        -re {.+} {
            append output $expect_out(buffer)
            exp_continue
        }
        eof {
            set wait_result [wait]
            set exit_code [lindex $wait_result 3]
        }
        timeout {
            log_event "Verification timed out"
            catch {close}
            catch {wait}
            set exit_code 124
        }
    }
    set timeout $saved_timeout
    log_user 1
    if {$exit_code == 0} {
        set trimmed [string trim $output]
        if {!$quiet && $trimmed ne ""} {
            puts $trimmed
        }
        log_event "Verification succeeded"
        return 0
    }
    log_event "Verification failed with exit $exit_code"
    return 1
}

proc wait_for_verification {verify_args check_args label max_seconds} {
    set deadline [expr {[clock seconds] + $max_seconds}]
    set attempt 0
    set last_heartbeat 0
    while {[clock seconds] < $deadline} {
        incr attempt
        set master_up 1
        if {[llength $check_args] > 0} {
            set master_up [expr {[verify_ssh $check_args 1] == 0 ? 1 : 0}]
        }
        if {$master_up && [verify_ssh $verify_args] == 0} {
            log_event "$label verification succeeded after $attempt attempts"
            return 0
        }
        set now [clock seconds]
        if {$now - $last_heartbeat >= 5} {
            status_line "waiting for Duo approval on your phone ($label)"
            set last_heartbeat $now
        }
        after 1000
    }
    log_event "$label verification did not succeed within $max_seconds seconds"
    return 1
}

proc ensure_connection {verify_args interactive_args close_args success_re label control_path force} {
    if {$force eq "1"} {
        close_master $close_args $label $control_path
        set auth_exit [run_interactive_ssh $interactive_args $success_re $label]
        if {$auth_exit != 0} {
            log_event "$label authentication returned $auth_exit; verifying control connection before failing"
        }
        if {[verify_ssh $verify_args] == 0} {
            status_line [connected_message $label]
            return 0
        }
        return [expr {$auth_exit == 0 ? 1 : $auth_exit}]
    }
    if {[verify_ssh $verify_args] == 0} {
        status_line [connected_message $label]
        return 0
    }
    cleanup_control_socket $control_path
    cleanup_orphan_master $control_path
    set auth_exit [run_interactive_ssh $interactive_args $success_re $label]
    if {[verify_ssh $verify_args] == 0} {
        status_line [connected_message $label]
        return 0
    }
    return [expr {$auth_exit == 0 ? 1 : $auth_exit}]
}

proc start_askpass_master {verify_args check_args master_args close_args label control_path force} {
    global password duo_option

    set runtime_dir [resolve_path ".runtime"]
    ensure_directory $runtime_dir
    set log_path [file join $runtime_dir "aire_master_ssh.log"]
    set pid_path [file join $runtime_dir "aire_master_ssh.pid"]
    set starter_log [file join $runtime_dir "aire_master_starter.log"]

    if {$force eq "1"} {
        close_master $close_args $label $control_path
        cleanup_orphan_master $control_path $pid_path
    } elseif {[verify_ssh $verify_args] == 0} {
        status_line [connected_message $label]
        return 0
    } else {
        cleanup_control_socket $control_path
        cleanup_orphan_master $control_path $pid_path
    }

    set askpass_path [resolve_path "scripts/aire_ssh_askpass.sh"]
    if {![file executable $askpass_path]} {
        puts stderr "Askpass helper is missing or not executable: $askpass_path"
        log_event "$label askpass helper missing: $askpass_path"
        return 2
    }
    set starter_path [resolve_path "scripts/aire_start_background_ssh.zsh"]
    if {![file executable $starter_path]} {
        puts stderr "Background SSH starter is missing or not executable: $starter_path"
        log_event "$label background starter missing: $starter_path"
        return 2
    }

    # Secrets are handed to the starter through this process's environment
    # only — never on the command line, where they would be visible to other
    # local users via `ps`. They are scrubbed again immediately after exec.
    set ::env(AIRE_ASKPASS_PASSWORD) $password
    set ::env(AIRE_ASKPASS_DUO_OPTION) $duo_option
    set ::env(AIRE_BACKGROUND_SSH_PID_FILE) $pid_path
    set ::env(AIRE_BACKGROUND_STARTER_LOG) $starter_log
    set ::env(SSH_ASKPASS) $askpass_path
    set ::env(SSH_ASKPASS_REQUIRE) "force"
    if {![info exists ::env(DISPLAY)] || $::env(DISPLAY) eq ""} {
        set ::env(DISPLAY) ":0"
    }

    log_event "Starting $label background master with askpass"
    status_line [starting_message $label]
    set start_error ""
    if {[catch {
        set starter_pid [exec $starter_path $log_path {*}$master_args]
    } error]} {
        set start_error $error
    }
    catch {unset ::env(AIRE_ASKPASS_PASSWORD)}
    catch {unset ::env(AIRE_ASKPASS_DUO_OPTION)}

    if {$start_error ne ""} {
        puts stderr "Failed to start $label background master: $start_error"
        log_event "Failed to start $label background master: $start_error"
        return 1
    }
    log_event "$label background starter pid: $starter_pid (ssh master pid is recorded in $pid_path)"

    if {[wait_for_verification $verify_args $check_args $label 90] == 0} {
        status_line [connected_message $label]
        return 0
    }

    puts stderr "$label background master did not become usable. See $log_path"
    cleanup_control_socket $control_path
    cleanup_orphan_master $control_path $pid_path
    return 1
}

set jump_command {printf 'jump_ok|%s|%s|%s\n' "$(hostname -f 2>/dev/null || hostname)" "$(whoami)" "$(date -Iseconds 2>/dev/null || date)"}
set target_command {printf 'auth_ok|%s|%s|%s\n' "$(hostname -f 2>/dev/null || hostname)" "$(whoami)" "$(date -Iseconds 2>/dev/null || date)"}

if {$connection_mode eq "alias"} {
    set target_args [add_interactive_master_options [interactive_base_args] $control_path]
    lappend target_args -f $ssh_alias sleep 86400

    set verify_target_args [add_verify_master_options [verify_base_args] $control_path]
    lappend verify_target_args $ssh_alias $target_command

    set close_target_args [add_verify_master_options [verify_base_args] $control_path]
    lappend close_target_args $ssh_alias

    set target_exit [ensure_connection $verify_target_args $target_args $close_target_args "" "AIRE" $control_path $force_relogin]
    exit $target_exit
}

if {$use_jump_host eq "1"} {
    set jump_args [add_interactive_master_options [interactive_base_args] $jump_control_path]
    lappend jump_args -f -N -o User=$username $jump_hostname

    # Verify the jump master with `ssh -O check` (an instant local socket
    # probe) instead of `-W aire:22`, which opens a raw TCP channel to the
    # remote sshd and can hang until LoginGraceTime.
    set verify_jump_args [add_verify_master_options [verify_base_args] $jump_control_path]
    lappend verify_jump_args -O check -o User=$username $jump_hostname

    set close_jump_args [add_verify_master_options [verify_base_args] $jump_control_path]
    lappend close_jump_args -o User=$username $jump_hostname

    set jump_exit [ensure_connection $verify_jump_args $jump_args $close_jump_args "" "jump host" $jump_control_path $force_relogin]
    if {$jump_exit != 0} {
        exit $jump_exit
    }
}

if {$skip_target eq "1"} {
    log_event "Skipping AIRE target authentication by request"
    exit 0
}

set target_args [add_background_master_options [askpass_base_args] $control_path]
lappend target_args -o User=$username
if {$use_jump_host eq "1"} {
    set proxy_command [jump_proxy_command]
    if {$proxy_command ne ""} {
        lappend target_args -o ProxyCommand=$proxy_command
    } else {
        lappend target_args -o ProxyJump=$username@$jump_hostname
    }
} else {
    lappend target_args -o ProxyCommand=none -o ProxyJump=none
}
lappend target_args $aire_hostname sleep 86400

set verify_target_args [add_verify_master_options [verify_base_args] $control_path]
lappend verify_target_args -o User=$username
if {$use_jump_host eq "1"} {
    set proxy_command [jump_proxy_command]
    if {$proxy_command ne ""} {
        lappend verify_target_args -o ProxyCommand=$proxy_command
    } else {
        lappend verify_target_args -o ProxyJump=$username@$jump_hostname
    }
} else {
    lappend verify_target_args -o ProxyCommand=none -o ProxyJump=none
}
lappend verify_target_args $aire_hostname $target_command

# Instant socket-liveness probe used to gate the slower full verification.
set check_target_args [add_verify_master_options [verify_base_args] $control_path]
lappend check_target_args -O check -o User=$username $aire_hostname

set close_target_args [add_verify_master_options [verify_base_args] $control_path]
lappend close_target_args -o User=$username
if {$use_jump_host eq "1"} {
    set proxy_command [jump_proxy_command]
    if {$proxy_command ne ""} {
        lappend close_target_args -o ProxyCommand=$proxy_command
    } else {
        lappend close_target_args -o ProxyJump=$username@$jump_hostname
    }
} else {
    lappend close_target_args -o ProxyCommand=none -o ProxyJump=none
}
lappend close_target_args $aire_hostname

set target_exit [start_askpass_master $verify_target_args $check_target_args $target_args $close_target_args "AIRE" $control_path $force_relogin]
exit $target_exit
